# Copiar a .env y generar una clave secreta propia antes de usar Django.
# Este archivo es un ejemplo: no contiene credenciales reales.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL del curso mediante tunel SSH local (entorno de desarrollo).
POSTGRES_DB=cc3201
POSTGRES_USER=cc3201
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5540

# Tiempo máximo para establecer conexión (segundos) y para cada SELECT (ms).
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# Producción: activar solamente cuando el servidor HTTPS esté configurado.
DJANGO_HTTPS_ENABLED=False
DJANGO_FORCE_HTTPS_REDIRECT=False
DJANGO_HSTS_SECONDS=0
DJANGO_CSRF_TRUSTED_ORIGINS=
