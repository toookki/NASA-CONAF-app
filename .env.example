# Copiar a .env y generar una clave secreta propia antes de usar Django.
# Este archivo es un ejemplo: no contiene credenciales reales.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL del curso mediante tunel SSH local (entorno de desarrollo).
POSTGRES_DB=cc3201
POSTGRES_USER=cc3201
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5540
